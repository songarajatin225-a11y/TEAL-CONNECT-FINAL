# Copy to .env and fill in. .env is git-ignored.
#
# Both values come from your Supabase dashboard: Project Settings → API.

# The project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# The anon / publishable key — the long one labelled "anon public".
#
# This is a public credential: it is written into config.json, which every
# browser downloads. That is fine and intended. It grants nothing on its own,
# because every table has row-level security and an unauthenticated caller
# gets zero rows.
#
# The service_role key is the other one on that page. It bypasses row-level
# security entirely. It belongs in the shell you run supabase/seed.mjs from and
# nowhere else — never here, never in the repository, never in a browser.
SUPABASE_ANON_KEY=

# server | demo | auto
#   server  refuse to start without a working Supabase project (use this in production)
#   demo    ignore Supabase and run on seed data
#   auto    use Supabase when configured, fall back to demo
APP_MODE=server

# Shown in the topbar, e.g. "Staging". Leave empty in production.
ENVIRONMENT_LABEL=

# Host port. Bound to 127.0.0.1 — the reverse proxy is what faces the internet.
APP_PORT=8080
